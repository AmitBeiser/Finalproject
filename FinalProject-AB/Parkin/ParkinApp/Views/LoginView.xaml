<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ParkinApp.ViewModels"
             x:Class="ParkinApp.Views.LoginView"
             x:DataType="viewmodels:LoginViewModel"
             Title="התחברות - Parkin'">

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Label Text="Parkin'"
               FontSize="36"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="Email" />
        <Entry Placeholder="Enter Email"
               Keyboard="Email"
               Text="{Binding Email}" />

        <Label Text="Password" />
        <Entry Placeholder="Enter Password"
               IsPassword="True"
               Text="{Binding Password}" />

        <Label Text="{Binding ErrorMsg}"
               TextColor="Red"
               HorizontalOptions="Center" />

        <Button Text="Login"
                Command="{Binding LoginCommand}" />

        <Button Text="Forgot Password"
                BackgroundColor="Transparent"
                TextColor="Gray"
                Command="{Binding ForgotPasswordCommand}" />

        <Button Text="Don't have an account? Register here"
                BackgroundColor="Transparent"
                TextColor="DodgerBlue"
                Command="{Binding RegisterCommand}" />

    </VerticalStackLayout>
</ContentPage>
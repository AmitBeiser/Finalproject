<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ParkinApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ParkinApp.Views"
    Title="ParkinApp">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginView}"  
        Route="LoginView" />
    
    <ShellContent
        Title="Feed"
        ContentTemplate="{DataTemplate views:FeedView}"
        Route="FeedView" />

</Shell>
